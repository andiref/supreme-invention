# Frontend Firebase configuration is in src/firebase/config.js.
# The same web API key is public; expose it to Vercel only so the API can
# validate Firebase ID tokens with the Identity Toolkit endpoint.
FIREBASE_WEB_API_KEY=AIzaSyDb5NmUfwEDThWtmvnR7NF-rk8ATHoClW0
FIREBASE_PROJECT_ID=smt-engineer-report
FIREBASE_CLIENT_EMAIL=service-account-email@PROJECT.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Used by /api/* for the owner check, AND by `npm run rules:build` to render
# firebase.rules.json from firebase.rules.template.json (see README > Deployment).
OWNER_EMAIL=owner@example.com

# The exact origin of your deployed frontend (scheme + host, no trailing
# slash) — e.g. https://smt-engineer-report.vercel.app. Sent back as
# Access-Control-Allow-Origin by /api/* instead of '*'. If unset, /api/*
# falls back to '*' so local dev keeps working, but production should
# always set this.
ALLOWED_ORIGIN=https://your-deployed-app.vercel.app
